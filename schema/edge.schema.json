{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/edge.schema.json",
  "title": "Person graph edge",
  "description": "A directed relation between entries. Unresolved targets are kept as literals rather than dropped, so recall is visible.",
  "type": "object",
  "required": ["from_person_id", "type", "source", "resolved", "ambiguous"],
  "additionalProperties": false,
  "properties": {
    "from_person_id": { "type": "string", "pattern": "^[a-z]+:\\d+:\\d+-\\d+(?:\\.\\d+)?$" },
    "to_person_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z]+:\\d+:\\d+-\\d+(?:\\.\\d+)?$" },
        { "type": "null" }
      ]
    },
    "to_literal": {
      "type": ["string", "null"],
      "description": "Surface form of the target when it could not be resolved to an entry"
    },
    "type": {
      "type": "string",
      "enum": [
        "narrated_from",
        "narrated_to",
        "family",
        "see_entry",
        "see_adjacent",
        "see_relation",
        "see_qism",
        "see_section",
        "see_letter"
      ]
    },
    "relation": { "type": ["string", "null"] },
    "direction": { "type": ["string", "null"], "enum": ["forward", "backward", null] },
    "target_entry_number": { "type": ["integer", "null"] },
    "target_qism": { "type": ["integer", "null"], "enum": [1, 2, 3, 4, null] },
    "target_section": {
      "type": ["string", "null"],
      "enum": ["names", "kunya", "women", "mubhamat", null]
    },
    "target_letter": { "type": ["string", "null"] },
    "source": { "$ref": "fact.schema.json#/$defs/source" },
    "evidence": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "resolved": { "type": "boolean" },
    "ambiguous": {
      "type": "boolean",
      "description": "True when the reference matched more than one candidate entry"
    },
    "candidates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All candidate person_ids when the reference is ambiguous"
    }
  }
}
