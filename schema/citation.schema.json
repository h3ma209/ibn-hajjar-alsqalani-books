{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/citation.schema.json",
  "title": "Source citation",
  "description": "A named authority or work Ibn Hajar cites inside an entry. These are sources, not companions, so they are kept out of the person graph.",
  "type": "object",
  "required": ["person_id", "authority", "source"],
  "additionalProperties": false,
  "properties": {
    "person_id": { "type": "string", "pattern": "^[a-z]+:\\d+:\\d+-\\d+(?:\\.\\d+)?$" },
    "authority": { "type": "string", "minLength": 1 },
    "authority_key": { "type": ["string", "null"] },
    "verb": {
      "type": ["string", "null"],
      "description": "How the authority was invoked: ذكره, أخرج, قال, روى"
    },
    "evidence": { "type": ["string", "null"] },
    "source": { "$ref": "fact.schema.json#/$defs/source" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
