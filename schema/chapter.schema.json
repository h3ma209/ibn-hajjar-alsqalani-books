{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/chapter.schema.json",
  "title": "Non-entry chapter",
  "description": "Ibn Hajar's introduction and structural headings extracted from the TOC.",
  "type": "object",
  "required": ["chapter_id", "title", "kind", "start_id", "end_id"],
  "additionalProperties": false,
  "properties": {
    "chapter_id": { "type": "string" },
    "title": { "type": "string" },
    "lvl": { "type": "integer" },
    "kind": {
      "type": "string",
      "enum": [
        "preface", "definition", "method", "virtue_adala", "taxonomy",
        "qism_heading", "letter_heading", "block_heading", "volume_heading", "other"
      ]
    },
    "start_id": { "type": "integer" },
    "end_id": { "type": "integer" },
    "text": { "type": "string" },
    "text_truncated": { "type": "boolean" },
    "char_len": { "type": "integer", "minimum": 0 },
    "topics": { "type": "array", "items": { "type": "string" } }
  }
}
