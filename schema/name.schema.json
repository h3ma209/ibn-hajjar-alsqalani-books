{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/name.schema.json",
  "title": "Name variant",
  "description": "One searchable name form for a person: display, nasab, kunya, or a dispute candidate.",
  "type": "object",
  "required": ["person_id", "form", "form_norm", "kind"],
  "additionalProperties": false,
  "properties": {
    "person_id": { "type": "string" },
    "form": { "type": "string", "minLength": 1 },
    "form_norm": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["display", "full_nasab", "kunya", "ism", "laqab", "jahili", "prophetic_rename", "dispute", "other"]
    },
    "source": { "type": ["string", "null"] }
  }
}
