{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/person.schema.json",
  "title": "Companion record",
  "description": "One entry from al-Isabah. Structural fields are deterministic; life and narration fields are extracted and always carry provenance. v3 adds typed kinds, events, labels, and features.",
  "type": "object",
  "required": [
    "schema_version",
    "person_id",
    "book",
    "entry",
    "identity",
    "classification",
    "life",
    "narration",
    "labels",
    "features",
    "extraction"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "3.0.0" },
    "person_id": { "type": "string", "pattern": "^[a-z]+:\\d+:\\d+-\\d+(?:\\.\\d+)?$" },

    "book": {
      "type": "object",
      "required": ["slug", "book_id"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "book_id": { "type": ["integer", "null"] }
      }
    },

    "entry": {
      "type": "object",
      "required": ["number", "number_is_ambiguous", "start_id", "end_id", "marker", "length_class", "kind", "flags"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "number_is_ambiguous": {
          "type": "boolean",
          "description": "True when the source reuses this entry number for more than one person"
        },
        "start_id": { "type": "integer" },
        "end_id": { "type": "integer" },
        "volume": { "type": ["string", "null"] },
        "page_start": { "type": ["integer", "null"] },
        "page_end": { "type": ["integer", "null"] },
        "pdf_page": {
          "type": ["integer", "null"],
          "description": "Printed PDF page when a page-map exists. Null until then."
        },
        "char_len": { "type": "integer", "minimum": 0 },
        "marker": {
          "type": ["string", "null"],
          "description": "Shamela sub-marker between number and dash, e.g. ز for later additions"
        },
        "length_class": { "type": "string", "enum": ["stub", "short", "medium", "long"] },
        "kind": {
          "type": "string",
          "enum": ["biography", "crossref_stub", "name_only", "kunya_redirect", "qism4_refutation"]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "has_isnad",
              "has_name_dispute",
              "has_ibn_hajar_voice",
              "has_poetry",
              "has_hadith_matn",
              "footnote_heavy"
            ]
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["marker", "text"],
            "additionalProperties": false,
            "properties": {
              "marker": { "type": "integer" },
              "text": { "type": "string" },
              "page": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },

    "identity": {
      "type": "object",
      "required": ["display_name", "nasab", "is_woman", "laqab", "ism_status"],
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "display_name_norm": { "type": "string" },
        "kunya": { "type": ["string", "null"] },
        "laqab": { "type": ["string", "null"] },
        "is_woman": { "type": "boolean" },
        "ism_status": { "type": "string", "enum": ["agreed", "disputed", "unknown"] },
        "nasab": {
          "type": "object",
          "required": ["chain", "full_name", "source", "confidence"],
          "additionalProperties": false,
          "properties": {
            "ism": { "type": ["string", "null"] },
            "father": { "type": ["string", "null"] },
            "grandfather": { "type": ["string", "null"] },
            "great_grandfather": { "type": ["string", "null"] },
            "chain": { "type": "array", "items": { "type": "string" }, "maxItems": 25 },
            "links": { "type": "array", "items": { "type": "string" } },
            "nisba": { "type": "array", "items": { "type": "string" } },
            "full_name": { "type": ["string", "null"] },
            "full_name_norm": { "type": ["string", "null"] },
            "source": { "type": "string", "enum": ["heading", "ismuhu", "toc"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "rejected_reason": {
              "type": ["string", "null"],
              "description": "Why the parsed chain was discarded in favour of the TOC name"
            },
            "link_count": { "type": "integer", "minimum": 0 }
          }
        },
        "alternate_names": {
          "type": "array",
          "items": { "$ref": "fact.schema.json#/$defs/kindedFact" }
        },
        "name_dispute_notes": {
          "type": "array",
          "items": { "$ref": "fact.schema.json#/$defs/kindedFact" }
        }
      }
    },

    "classification": {
      "type": "object",
      "required": [
        "qism",
        "section_type",
        "entry_kind",
        "companionship_status",
        "generation",
        "origin",
        "status",
        "tribe_keys",
        "nisba_keys",
        "gender_source"
      ],
      "additionalProperties": false,
      "properties": {
        "qism": {
          "type": ["integer", "null"],
          "enum": [1, 2, 3, 4, null],
          "description": "Ibn Hajar's four-way division by strength of established companionship"
        },
        "qism_label": { "type": ["string", "null"] },
        "qism_heading": {
          "type": ["string", "null"],
          "description": "The verbatim qism heading in the TOC, kept separate from toc_heading"
        },
        "section_type": {
          "type": "string",
          "enum": ["names", "kunya", "women", "intro", "other"]
        },
        "letter": { "type": ["string", "null"] },
        "bab": { "type": ["string", "null"] },
        "volume_toc": { "type": ["string", "null"] },
        "toc_heading": {
          "type": ["string", "null"],
          "description": "Nearest TOC node title. Navigational only; never a scholarly claim."
        },
        "toc_path": { "type": "array", "items": { "type": "string" } },
        "entry_kind": {
          "type": "string",
          "enum": ["biography", "crossref_stub", "name_only", "kunya_redirect", "qism4_refutation"]
        },
        "companionship_status": {
          "type": "string",
          "enum": ["established", "vision_or_birth", "mukhadram", "listed_in_error", "disputed"]
        },
        "generation": {
          "type": "string",
          "enum": ["sahabi", "mukhadram", "tabii_mentioned", "unknown"]
        },
        "origin": {
          "type": "string",
          "enum": ["muhajir", "ansari", "other", "unknown"]
        },
        "status": {
          "type": "string",
          "enum": ["free", "mawla", "unknown"]
        },
        "tribe_keys": { "type": "array", "items": { "type": "string" } },
        "nisba_keys": { "type": "array", "items": { "type": "string" } },
        "gender_source": {
          "type": "string",
          "enum": ["women_section", "grammar", "name", "explicit"]
        }
      }
    },

    "life": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "anyOf": [{ "$ref": "fact.schema.json#/$defs/kindedFact" }, { "type": "null" }] },
        "birth": { "$ref": "#/$defs/lifeEvent" },
        "death": { "$ref": "#/$defs/lifeEvent" },
        "conversion": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "companionship": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "battles": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/vocabFact" } },
        "offices": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/officeFact" } },
        "family": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/familyFact" } },
        "residences": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/vocabFact" } },
        "traits": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "events": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/eventFact" } },
        "wounds": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "ages": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/ageFact" } },
        "possessions": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } }
      }
    },

    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_prolific": { "type": "boolean" },
        "hadith_count": {
          "anyOf": [{ "$ref": "fact.schema.json#/$defs/hadithCount" }, { "type": "null" }]
        },
        "narrated_from": {
          "type": "array",
          "items": { "$ref": "fact.schema.json#/$defs/namedFact" }
        },
        "narrated_to": {
          "type": "array",
          "items": { "$ref": "fact.schema.json#/$defs/namedFact" }
        },
        "praise": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "criticism": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "defenses": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } },
        "verdict_keys": { "type": "array", "items": { "type": "string" } }
      }
    },

    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "source": { "$ref": "fact.schema.json#/$defs/source" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "features": { "$ref": "#/$defs/features" },

    "extraction": {
      "type": "object",
      "required": ["layers"],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "items": { "type": "string", "enum": ["structural", "regex", "llm"] }
        },
        "llm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "prompt_version": { "type": "string" },
            "chunks": { "type": "integer", "minimum": 1 },
            "extracted_at": { "type": "string" },
            "truncated": { "type": "boolean" }
          }
        },
        "regex": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "extracted_at": { "type": "string" }
          }
        }
      }
    }
  },

  "$defs": {
    "hijriYear": {
      "type": ["integer", "null"],
      "minimum": -100,
      "maximum": 1500,
      "description": "Hijri year. Negative values are years before the Hijra, which many Companions' birth dates require (the entry may date a birth relative to the Prophetic mission)."
    },
    "lifeEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "year_hijri": { "$ref": "#/$defs/hijriYear" },
        "year_uncertain": {
          "type": "boolean",
          "description": "True when the source reports competing years or hedges the date"
        },
        "year_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/hijriYear" },
          "description": "All years the source mentions for this event"
        },
        "place": { "type": ["string", "null"] },
        "place_key": { "type": ["string", "null"] },
        "cause": { "type": ["string", "null"] },
        "cause_key": { "type": ["string", "null"] },
        "age_years": { "type": ["integer", "null"], "minimum": 0, "maximum": 200 },
        "notes": { "type": "array", "items": { "$ref": "fact.schema.json#/$defs/kindedFact" } }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_events",
        "n_battles",
        "n_isnads",
        "n_citations",
        "n_family",
        "n_offices",
        "n_unlabeled_sents",
        "fought",
        "wounded",
        "shahid",
        "captive",
        "muhajir",
        "ansari",
        "has_death_year",
        "has_isnad",
        "name_disputed",
        "label_coverage"
      ],
      "properties": {
        "n_events": { "type": "integer", "minimum": 0 },
        "n_battles": { "type": "integer", "minimum": 0 },
        "n_isnads": { "type": "integer", "minimum": 0 },
        "n_citations": { "type": "integer", "minimum": 0 },
        "n_family": { "type": "integer", "minimum": 0 },
        "n_offices": { "type": "integer", "minimum": 0 },
        "n_unlabeled_sents": { "type": "integer", "minimum": 0 },
        "fought": { "type": "boolean" },
        "wounded": { "type": "boolean" },
        "shahid": { "type": "boolean" },
        "captive": { "type": "boolean" },
        "muhajir": { "type": "boolean" },
        "ansari": { "type": "boolean" },
        "has_death_year": { "type": "boolean" },
        "has_isnad": { "type": "boolean" },
        "name_disputed": { "type": "boolean" },
        "label_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
