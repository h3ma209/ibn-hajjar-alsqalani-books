{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/fact.schema.json",
  "title": "Fact primitives",
  "description": "Every extracted claim carries where it came from, the verbatim text that supports it, and how confident the extractor was. Nothing in this corpus is an unattributed assertion.",
  "$defs": {
    "source": {
      "type": "string",
      "enum": ["structural", "regex", "llm"],
      "description": "structural = derived deterministically from the book's own markup; regex = heuristic pattern match; llm = model extraction"
    },
    "fact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "evidence": {
          "type": ["string", "null"],
          "description": "Verbatim Arabic from the entry that supports the value"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"] },
        "kind": { "type": ["string", "null"] },
        "key": { "type": ["string", "null"] }
      }
    },
    "kindedFact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": { "type": ["string", "null"] },
        "key": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"] }
      }
    },
    "eventFact": {
      "type": "object",
      "required": ["value", "kind", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "battle", "sariyya", "siege", "conquest", "ridda", "fitna",
            "treaty", "bayah", "hudna",
            "hijra", "wufd", "embassy", "exile", "settlement",
            "wound", "captivity", "ransom", "martyrdom", "killing", "plague", "assassination",
            "meeting", "letter_from_prophet", "letter_to_prophet", "gift", "duaa", "bashara",
            "marriage", "divorce", "childbirth", "manumission", "inheritance", "land", "horse_or_property",
            "quran", "poetry", "fatwa", "dream", "karama",
            "incident"
          ]
        },
        "key": { "type": ["string", "null"] },
        "year_hijri": { "type": ["integer", "null"] },
        "place": { "type": ["string", "null"] },
        "place_key": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ageFact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": { "type": ["string", "null"], "enum": ["at_islam", "at_death", "at_event", null] },
        "years": { "type": ["integer", "null"], "minimum": 0, "maximum": 200 },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "hadithCount": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "uncertain": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "namedFact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "normalized": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"] }
      }
    },
    "vocabFact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "key": {
          "type": ["string", "null"],
          "description": "Controlled-vocabulary key, null when the surface form matched nothing known"
        },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"] }
      }
    },
    "officeFact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "role": { "type": ["string", "null"] },
        "place": { "type": ["string", "null"] },
        "place_key": { "type": ["string", "null"] },
        "appointed_by": { "type": ["string", "null"] },
        "period": { "type": ["string", "null"] },
        "role_key": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"] }
      }
    },
    "familyFact": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "relation": {
          "type": ["string", "null"],
          "enum": [
            "father", "mother", "son", "daughter", "brother", "sister",
            "wife", "husband", "grandfather", "grandmother", "uncle", "aunt",
            "cousin", "descendant", "client", "other", null
          ]
        },
        "name": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" },
        "evidence": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"] }
      }
    }
  }
}
