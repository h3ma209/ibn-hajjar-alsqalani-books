{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isabah-corpus.local/schema/index.schema.json",
  "title": "Person index row",
  "description": "Lightweight browse/search row. Must be enough to filter without loading the full person record.",
  "type": "object",
  "required": [
    "person_id",
    "entry_number",
    "display_name",
    "qism",
    "section_type",
    "entry_kind",
    "length_class"
  ],
  "additionalProperties": false,
  "properties": {
    "person_id": { "type": "string" },
    "entry_number": { "type": "integer" },
    "entry_number_is_ambiguous": { "type": "boolean" },
    "display_name": { "type": "string" },
    "display_name_norm": { "type": ["string", "null"] },
    "full_name": { "type": ["string", "null"] },
    "full_name_norm": { "type": ["string", "null"] },
    "kunya": { "type": ["string", "null"] },
    "nisba": { "type": "array", "items": { "type": "string" } },
    "nasab_confidence": { "type": ["number", "null"] },
    "is_woman": { "type": "boolean" },
    "qism": { "type": ["integer", "null"] },
    "section_type": { "type": "string" },
    "letter": { "type": ["string", "null"] },
    "volume": { "type": ["string", "null"] },
    "page_start": { "type": ["integer", "null"] },
    "page_end": { "type": ["integer", "null"] },
    "char_len": { "type": "integer" },
    "death_year_hijri": { "type": ["integer", "null"] },
    "layers": { "type": "array", "items": { "type": "string" } },
    "entry_marker": { "type": ["string", "null"] },
    "entry_kind": { "type": "string" },
    "length_class": { "type": "string" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "name_keys": { "type": "array", "items": { "type": "string" } },
    "battle_keys": { "type": "array", "items": { "type": "string" } },
    "event_keys": { "type": "array", "items": { "type": "string" } },
    "place_keys": { "type": "array", "items": { "type": "string" } },
    "nisba_keys": { "type": "array", "items": { "type": "string" } },
    "verdict_keys": { "type": "array", "items": { "type": "string" } },
    "ism_norm": { "type": ["string", "null"] },
    "father_norm": { "type": ["string", "null"] },
    "kunya_norm": { "type": ["string", "null"] },
    "death_place_key": { "type": ["string", "null"] },
    "fought": { "type": "boolean" },
    "shahid": { "type": "boolean" },
    "label_coverage": { "type": "number" }
  }
}
