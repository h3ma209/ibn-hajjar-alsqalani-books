{
  "name": "isabah_entry_extraction",
  "description": "Structured facts extracted from one al-Isabah biographical entry. Self-contained and strict-mode compatible: every property is required, optionals are nullable, and no unsupported keywords are used.",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "kunya",
      "is_woman",
      "alternate_names",
      "name_dispute_notes",
      "birth",
      "death",
      "conversion",
      "companionship",
      "battles",
      "offices",
      "family",
      "residences",
      "traits",
      "narration",
      "cited_authorities",
      "cross_references"
    ],
    "properties": {
      "summary": {
        "type": ["string", "null"],
        "description": "One or two Arabic sentences identifying the person, taken from the entry's own wording"
      },
      "kunya": { "type": ["string", "null"], "description": "e.g. أبو عبد الرحمن" },
      "is_woman": { "type": "boolean" },
      "alternate_names": {
        "type": "array",
        "items": { "$ref": "#/$defs/fact" }
      },
      "name_dispute_notes": {
        "type": "array",
        "items": { "$ref": "#/$defs/fact" }
      },
      "birth": { "$ref": "#/$defs/lifeEvent" },
      "death": { "$ref": "#/$defs/lifeEvent" },
      "conversion": {
        "type": "array",
        "description": "Statements about entering Islam, emigration, or first arrival",
        "items": { "$ref": "#/$defs/fact" }
      },
      "companionship": {
        "type": "array",
        "description": "Statements about contact with the Prophet: seeing, accompanying, serving, or being sent by him",
        "items": { "$ref": "#/$defs/fact" }
      },
      "battles": {
        "type": "array",
        "description": "Events witnessed. Put the event name in value, e.g. خيبر",
        "items": { "$ref": "#/$defs/fact" }
      },
      "offices": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "role", "place", "appointed_by", "period", "evidence"],
          "properties": {
            "value": { "type": "string" },
            "role": { "type": ["string", "null"], "description": "e.g. أمير, قاض, عامل" },
            "place": { "type": ["string", "null"] },
            "appointed_by": { "type": ["string", "null"] },
            "period": { "type": ["string", "null"] },
            "evidence": { "type": ["string", "null"] }
          }
        }
      },
      "family": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "relation", "name", "evidence"],
          "properties": {
            "value": { "type": "string" },
            "relation": {
              "type": ["string", "null"],
              "enum": [
                "father", "mother", "son", "daughter", "brother", "sister",
                "wife", "husband", "grandfather", "grandmother", "uncle",
                "aunt", "cousin", "descendant", "client", "other", null
              ]
            },
            "name": { "type": ["string", "null"] },
            "evidence": { "type": ["string", "null"] }
          }
        }
      },
      "residences": {
        "type": "array",
        "description": "Places the person settled in or was counted among",
        "items": { "$ref": "#/$defs/fact" }
      },
      "traits": {
        "type": "array",
        "description": "Physical description, demeanour, worship, and lifestyle",
        "items": { "$ref": "#/$defs/fact" }
      },
      "narration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "is_prolific",
          "hadith_count",
          "narrated_from",
          "narrated_to",
          "praise",
          "criticism",
          "defenses"
        ],
        "properties": {
          "is_prolific": {
            "type": "boolean",
            "description": "True only if the entry says the person narrated a great deal"
          },
          "hadith_count": { "type": ["string", "null"] },
          "narrated_from": {
            "type": "array",
            "description": "People this person narrated from. One name per item, no prose.",
            "items": { "$ref": "#/$defs/fact" }
          },
          "narrated_to": {
            "type": "array",
            "description": "People who narrated from this person. One name per item, no prose.",
            "items": { "$ref": "#/$defs/fact" }
          },
          "praise": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
          "criticism": {
            "type": "array",
            "description": "Objections raised against the person or their narration",
            "items": { "$ref": "#/$defs/fact" }
          },
          "defenses": {
            "type": "array",
            "description": "Replies answering those objections",
            "items": { "$ref": "#/$defs/fact" }
          }
        }
      },
      "cited_authorities": {
        "type": "array",
        "description": "Scholars or books the entry cites as sources",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "verb", "evidence"],
          "properties": {
            "value": { "type": "string" },
            "verb": {
              "type": ["string", "null"],
              "description": "How they were invoked: ذكره, أخرج, قال, روى"
            },
            "evidence": { "type": ["string", "null"] }
          }
        }
      },
      "cross_references": {
        "type": "array",
        "description": "Pointers to other entries in this same book",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "kind",
            "target_entry_number",
            "target_qism",
            "target_name",
            "evidence"
          ],
          "properties": {
            "value": { "type": "string" },
            "kind": {
              "type": "string",
              "enum": ["see_entry", "see_qism", "see_section", "see_letter"]
            },
            "target_entry_number": { "type": ["integer", "null"] },
            "target_qism": { "type": ["integer", "null"], "enum": [1, 2, 3, 4, null] },
            "target_name": { "type": ["string", "null"] },
            "evidence": { "type": ["string", "null"] }
          }
        }
      }
    },
    "$defs": {
      "fact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "evidence"],
        "properties": {
          "value": { "type": "string" },
          "evidence": {
            "type": ["string", "null"],
            "description": "Verbatim span copied from the entry that supports this value"
          }
        }
      },
      "lifeEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year_hijri",
          "year_candidates",
          "year_uncertain",
          "place",
          "cause",
          "evidence"
        ],
        "properties": {
          "year_hijri": {
            "type": ["integer", "null"],
            "minimum": -100,
            "maximum": 1500,
            "description": "Best single Hijri year, or null if the entry gives none. Negative means before the Hijra. An age in years is not a year."
          },
          "year_candidates": {
            "type": "array",
            "description": "Every Hijri year the entry offers for this event",
            "items": { "type": "integer", "minimum": -100, "maximum": 1500 }
          },
          "year_uncertain": {
            "type": "boolean",
            "description": "True when the entry reports competing years or hedges"
          },
          "place": { "type": ["string", "null"] },
          "cause": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    }
  }
}
