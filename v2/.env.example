# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, local vLLM, ...)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Concurrency and per-request output cap
LLM_CONCURRENCY=6
LLM_MAX_TOKENS=4096

# Cost guard, in USD. The extract run aborts before exceeding this.
LLM_MAX_COST=15

# Per-million-token prices used for the spend estimate in reports/llm-usage.json.
# Adjust to match your provider or the run cost figures will be wrong.
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.60

# Path to the Shamela source book. Defaults to the nearest *.bok in the repo root.
# BOK_PATH=../الإصابة في تمييز الصحابة.bok
